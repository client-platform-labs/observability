{
  "schemaVersion": "0",
  "products": {
    "observability": {
      "preset": "react-vite",
      "sampling": {
        "defaultRate": 1
      },
      "redaction": {
        "enabled": true,
        "keys": [
          "password",
          "token",
          "authorization"
        ]
      }
    }
  }
}
