{
  "name": "@client-platform/observability",
  "version": "0.0.0",
  "description": "Observability CLI for Client Platform Labs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "observability": "./bin/observability.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "observability": "node ./bin/observability.js"
  },
  "dependencies": {
    "@client-platform/kernel": "file:../kernel/packages/kernel",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "clientPlatform": {
    "name": "@client-platform/observability",
    "schemaVersion": "0",
    "compatibility": {
      "cli": ">=0.0.0",
      "manifest": ">=0"
    },
    "supports": {
      "targets": ["web"]
    },
    "capabilities": ["commands"]
  }
}
